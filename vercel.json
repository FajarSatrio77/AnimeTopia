{
    "rewrites": [
        { "source": "/(.*)", "destination": "/index.html" }
    ],
    "routes": [
        {
            "src": "^/assets/(.*)",
            "dest": "/assets/$1"
        },
        {
            "src": "^/favicon.ico",
            "dest": "/favicon.ico"
        },
        {
            "src": "^/robots.txt",
            "dest": "/robots.txt"
        },
        {
            "handle": "filesystem"
        },
        {
            "src": "/(.*)",
            "dest": "/index.html"
        }
    ]
}