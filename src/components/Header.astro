---
import UserMenu from './UserMenu.astro';
---

<div
  id="main-navbar"
  class="sticky top-0 left-0 right-0 navbar bg-[#2D2D2D]/90 backdrop-blur-md shadow-sm z-[100] rounded-b-lg transition-all duration-300"
>
  <div class="navbar-start">
    <!-- Mobile Menu (Hamburger) -->
    <div class="dropdown lg:hidden">
      <label tabindex="0" role="button" class="btn btn-ghost btn-circle hamburger-btn relative z-[101]">
        <div class="hamburger">
          <span class="line"></span>
          <span class="line"></span>
          <span class="line"></span>
        </div>
      </label>
      <ul
        tabindex="0"
        class="menu menu-sm dropdown-content bg-[#2D2D2D] rounded-box z-[102] mt-3 w-64 p-2 shadow-lg animate-fadeIn mobile-menu fixed left-2 top-16"
        id="mobile-menu"
      >
        <!-- Search Bar for Mobile -->
        <li class="mb-2">
          <form action="/search" method="get" class="join w-full">
            <input type="text" name="q" placeholder="Cari anime..." class="input input-bordered join-item w-full" />
            <button class="btn btn-primary join-item">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-5 w-5"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
              </svg>
            </button>
          </form>
        </li>
        <div class="bg-[#2D2D2D] rounded-lg shadow-inner">
          <li><a href="/" class="hover:bg-primary/20">Ongoing</a></li>
          <li><a href="/completed" class="hover:bg-primary/20">Completed</a></li>
          <li><a href="/genre" class="hover:bg-primary/20">Genre</a></li>
          <li><a href="/trending" class="hover:bg-primary/20">Terlaris</a></li>
          <li><a href="/top-rated" class="hover:bg-primary/20">Rating Tertinggi</a></li>
          <li class="divider my-1"></li>
          <li class="guest-only"><a href="/akun" class="hover:bg-primary/20">Login / Daftar</a></li>
          <li class="user-only"><a href="/favorites" class="hover:bg-primary/20">Favorit <span id="mobile-favorites-count" class="badge badge-sm badge-primary ml-1 hidden">0</span></a></li>
          <li class="user-only"><a href="/history" class="hover:bg-primary/20">Riwayat Tontonan</a></li>
          <li class="user-only"><a href="/akun" class="hover:bg-primary/20">Profile</a></li>
        </div>
      </ul>
    </div>
    
    <!-- Desktop Navigation on left -->
    <div class="hidden lg:flex">
      <ul class="menu menu-horizontal px-1 desktop-nav">
        <li><a href="/" class={Astro.url.pathname === "/" ? "active" : ""}>Ongoing</a></li>
        <li><a href="/completed" class={Astro.url.pathname === "/completed" ? "active" : ""}>Completed</a></li>
        <li><a href="/genre" class={Astro.url.pathname === "/genre" ? "active" : ""}>Genre</a></li>
        <li><a href="/trending" class={Astro.url.pathname === "/trending" ? "active" : ""}>Terlaris</a></li>
        <li><a href="/top-rated" class={Astro.url.pathname === "/top-rated" ? "active" : ""}>Rating Tertinggi</a></li>
      </ul>
    </div>
    
    <!-- Centered Logo for Mobile -->
    <a href="/" class="lg:hidden mx-auto btn btn-ghost text-xl">AnimeTopia</a>
  </div>
  
  <!-- Desktop Logo in center -->
  <div class="navbar-center hidden lg:flex">
    <a href="/" class="btn btn-ghost text-xl">AnimeTopia</a>
  </div>
  
  <div class="navbar-end">
    <!-- Search Button (Desktop Only) -->
    <div class="dropdown dropdown-end mr-2 hidden lg:block">
      <button tabindex="0" class="btn btn-ghost btn-circle">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-5 w-5"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
        </svg>
      </button>
      <div tabindex="0" class="dropdown-content z-[103] menu p-2 shadow bg-[#2D2D2D] rounded-box w-80 animate-fadeIn">
        <form action="/search" method="get" class="p-2">
          <div class="join w-full">
            <input type="text" name="q" placeholder="Cari anime..." class="input input-bordered join-item w-full" />
            <button class="btn btn-primary join-item">Cari</button>
          </div>
        </form>
      </div>
    </div>
    
    <!-- Mobile Search Button -->
    <button class="btn btn-ghost btn-circle lg:hidden relative z-[101]" id="mobile-search-btn">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="h-5 w-5"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
      </svg>
    </button>

    <!-- Mobile Search Modal -->
    <dialog id="search-modal" class="modal modal-bottom">
      <div class="modal-box bg-[#2D2D2D] p-4">
        <h3 class="font-bold text-lg mb-4">Cari Anime</h3>
        <form action="/search" method="get">
          <div class="join w-full">
            <input type="text" name="q" placeholder="Cari anime..." class="input input-bordered join-item w-full" />
            <button class="btn btn-primary join-item">Cari</button>
          </div>
        </form>
      </div>
      <form method="dialog" class="modal-backdrop bg-black/80">
        <button>close</button>
      </form>
    </dialog>
    
    <!-- User Menu (Desktop) -->
    <div class="hidden lg:block">
      <UserMenu />
    </div>
  </div>
</div>

<style>
  /* Hamburger Menu Animation */
  .hamburger {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    width: 20px;
    height: 16px;
    cursor: pointer;
    transition: transform 0.3s ease-in-out;
  }

  .hamburger .line {
    display: block;
    width: 100%;
    height: 2px;
    background-color: currentColor;
    border-radius: 2px;
    transition: transform 0.3s ease-in-out, opacity 0.3s ease-in-out;
  }
  
  .dropdown:focus-within .hamburger {
    transform: rotate(90deg);
  }
  
  .dropdown:focus-within .hamburger .line:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  
  .dropdown:focus-within .hamburger .line:nth-child(2) {
    opacity: 0;
  }
  
  .dropdown:focus-within .hamburger .line:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }
  
  /* Mobile menu backdrop */
  .mobile-menu::before {
    content: '';
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.5);
    z-index: -1;
      opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
    }

  .mobile-menu:focus-within::before {
      opacity: 1;
  }

  /* Ensure mobile menu is above other content and stays visible */
  .mobile-menu {
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
    display: none;
  }

  /* Keep menu visible when dropdown is focused */
  .dropdown:focus-within .mobile-menu {
    display: block !important;
  }

  /* Prevent menu from disappearing on interaction */
  .mobile-menu:hover,
  .mobile-menu:focus-within {
    display: block !important;
  }

  /* Modal styles */
  .modal-box {
    max-height: 90vh;
  }

  @media (max-width: 640px) {
    .mobile-menu {
      max-height: calc(100vh - 5rem);
      overflow-y: auto;
    }
  }
  
  /* Desktop Navigation Styling */
  .desktop-nav a {
    opacity: 0.7;
    transition: opacity 0.3s, border-bottom 0.3s;
    position: relative;
    padding-bottom: 0.5rem;
  }
  
  .desktop-nav a:hover {
    opacity: 1;
  }
  
  .desktop-nav a:hover::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 0;
    height: 2px;
    background: linear-gradient(to right, #4a9fff, #7c4dff);
    border-radius: 2px;
    animation: expandUnderline 0.3s forwards;
  }
  
  @keyframes expandUnderline {
    to {
      width: 60%;
    }
  }
  
  .desktop-nav a.active {
    opacity: 1;
  }
  
  .desktop-nav a.active::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 60%;
    height: 2px;
    background: linear-gradient(to right, #4a9fff, #7c4dff, #ff43a3);
    border-radius: 2px;
    animation: glowPulse 2s infinite alternate;
  }
  
  @keyframes glowPulse {
    0% {
      box-shadow: 0 0 2px rgba(76, 159, 255, 0.4);
    }
    100% {
      box-shadow: 0 0 8px rgba(124, 77, 255, 0.7);
    }
  }
  
  /* Centering for mobile */
  @media (max-width: 1023px) {
    .navbar-start {
      width: 100%;
      display: flex;
      justify-content: space-between;
    }
    
    .navbar-center, .navbar-end {
      display: none;
    }
  }
  
  /* User authentication state styling for mobile */
  .mobile-menu .user-only {
    display: none;
  }
  
  .mobile-menu .guest-only {
    display: block;
  }
  
  /* Show appropriate menu items based on login status */
  .mobile-menu.logged-in .user-only {
    display: block;
  }
  
  .mobile-menu.logged-in .guest-only {
    display: none;
  }
</style>

<script>
  // Check if the user is logged in
  function isLoggedIn() {
    try {
      const userData = localStorage.getItem('animetopia_user');
      return !!userData; // Convert to boolean - true if userData exists, false otherwise
    } catch (error) {
      console.error('Error checking login status:', error);
      return false;
    }
  }

  // Get the current user from localStorage
  function getLocalUser() {
    try {
      const userData = localStorage.getItem('animetopia_user');
      if (!userData) return null;
      return JSON.parse(userData);
    } catch (error) {
      console.error('Error getting user data:', error);
      return null;
    }
  }

  // Update all navigation menus based on login status
  function updateAllMenus() {
    // Check if user is logged in
    const isUserLoggedIn = isLoggedIn();
    
    // Update mobile menu
    const mobileMenu = document.getElementById('mobile-menu');
    if (mobileMenu) {
      if (isUserLoggedIn) {
        mobileMenu.classList.add('logged-in');
        updateMobileFavoritesCount();
      } else {
        mobileMenu.classList.remove('logged-in');
      }
    }
    
    // Update desktop menu (UserMenu component)
    const desktopUserMenu = document.querySelector('.user-menu');
    if (desktopUserMenu) {
      if (isUserLoggedIn) {
        desktopUserMenu.setAttribute('data-logged-in', 'true');
      } else {
        desktopUserMenu.setAttribute('data-logged-in', 'false');
      }
    }
  }

  // Update active state on navigation
  document.addEventListener('DOMContentLoaded', () => {
    // Update all menus immediately
    updateAllMenus();
    
    // Update active menu item
    const currentPath = window.location.pathname;
    const navLinks = document.querySelectorAll('.desktop-nav a');
    navLinks.forEach(link => {
      const href = link.getAttribute('href') || '';
      if (currentPath === href || (href !== '/' && currentPath.startsWith(href))) {
        link.classList.add('active');
      }
    });
    
    // Add storage event listener
    window.addEventListener('storage', (e) => {
      if (e.key === 'animetopia_user' || e.key?.startsWith('favorites_')) {
        updateAllMenus();
      }
    });
    
    // Handle logout link click events with proper type handling
    document.addEventListener('click', (event) => {
      const target = event.target;
      if (target instanceof HTMLElement) {
        const logoutLink = target.closest('.logout-link');
        if (logoutLink) {
          event.preventDefault();
          logoutUser();
        }
      }
    });
    
    // Check login status periodically to ensure UI is up to date
    setInterval(updateAllMenus, 2000);
  });
  
  // Function to check login status and update UI
  function checkLoginStatus() {
    // Get login status directly from localStorage
    const loggedIn = isLoggedIn();
    updateAllMenus();
  }
  
  // Function to update mobile favorites count
  function updateMobileFavoritesCount() {
    const favCountElement = document.getElementById('mobile-favorites-count');
    if (!favCountElement) return;
    
    try {
      const user = getLocalUser();
      if (!user || !user.uid) return;
      
      const key = `favorites_${user.uid}`;
      const favoritesData = localStorage.getItem(key);
      const favorites = favoritesData ? JSON.parse(favoritesData) : [];
      
      if (favorites.length > 0) {
        favCountElement.textContent = String(favorites.length);
        favCountElement.classList.remove('hidden');
      } else {
        favCountElement.classList.add('hidden');
      }
    } catch (error) {
      console.error('Error updating mobile favorites count:', error);
      favCountElement.classList.add('hidden');
    }
  }
  
  // Function to logout user
  function logoutUser() {
    try {
      localStorage.removeItem('animetopia_user');
      localStorage.removeItem('favorites');
      localStorage.removeItem('animeWatchHistory');
      
      // Force update UI before redirecting
      updateAllMenus();
      
      // Redirect to login page
      window.location.href = '/akun';
    } catch (error) {
      console.error('Error during logout:', error);
    }
  }
  
  // Also run on Astro view transitions
  document.addEventListener('astro:page-load', updateAllMenus);
  document.addEventListener('astro:after-swap', updateAllMenus);

  // Navbar scroll effect
  function handleScroll() {
    const navbar = document.getElementById('main-navbar');
    if (!navbar) return;

    if (window.scrollY > 20) {
      navbar.classList.remove('bg-[#2D2D2D]/90');
      navbar.classList.add('bg-[#2D2D2D]/50');
      navbar.classList.add('backdrop-blur-sm');
    } else {
      navbar.classList.add('bg-[#2D2D2D]/90');
      navbar.classList.remove('bg-[#2D2D2D]/50');
      navbar.classList.remove('backdrop-blur-sm');
    }
  }

  // Add scroll event listener
  window.addEventListener('scroll', handleScroll);
  
  // Handle page transitions
  document.addEventListener('astro:after-swap', () => {
    handleScroll(); // Re-check scroll position after page transition
  });

  // Mobile search modal functionality
  const searchBtn = document.getElementById('mobile-search-btn');
  const searchModal = document.getElementById('search-modal') as HTMLDialogElement;

  if (searchBtn && searchModal) {
    searchBtn.addEventListener('click', () => {
      searchModal.showModal();
      // Focus the search input when modal opens
      const searchInput = searchModal.querySelector('input[name="q"]') as HTMLInputElement;
      if (searchInput) {
        searchInput.focus();
      }
    });
  }

  // Close mobile menu when clicking outside
  document.addEventListener('click', (e) => {
    const mobileMenu = document.getElementById('mobile-menu');
    const hamburgerBtn = document.querySelector('.hamburger-btn');
    
    if (mobileMenu && hamburgerBtn) {
      const isClickInside = mobileMenu.contains(e.target as Node) || 
                          hamburgerBtn.contains(e.target as Node);
      
      // Only close if clicking outside AND the menu is actually visible
      if (!isClickInside && 
          mobileMenu.classList.contains('dropdown-content') && 
          getComputedStyle(mobileMenu).display !== 'none') {
        // Instead of removing focus, we'll handle this more explicitly
        const dropdownTrigger = document.querySelector('.dropdown') as HTMLElement;
        if (dropdownTrigger) {
          dropdownTrigger.blur();
          // Remove focus from any focused elements inside the menu
          const focusedElement = mobileMenu.querySelector(':focus') as HTMLElement;
          if (focusedElement) {
            focusedElement.blur();
          }
        }
      }
    }
  });
</script>