---
import "~/styles/theme.css";
import "~/styles/global.css";
import { ClientRouter } from "astro:transitions";
import Header from "~/components/Header.astro";
import Footer from "~/components/Footer.astro";
import Navbar from "~/components/Navbar.astro";
import "~/styles/tailwind.css";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Nonton anime subtitle Indonesia gratis tanpa iklan", hideHeader = false } = Astro.props;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="generator" content="{Astro.generator}" />
    <title>{title}</title>
    <ClientRouter />
    
    <!-- Auth check script -->
    <script type="module" src="/src/scripts/auth-check.js"></script>
    <!-- Navbar scroll effect -->
    <script type="module" src="/src/scripts/navbar-scroll.js"></script>
  </head>
  <body>
    {!hideHeader && <Header />}
    <div class="flex flex-col items-center px-2">
      <div class="max-w-7xl w-full min-h-screen">
        <slot />
      </div>
    </div>
    <Footer />
  </body>
</html>