---
import Layout from "~/layouts/Layout.astro";
import { activatePremium } from "~/utils/subscription";

// Get plan from URL params
const plan = Astro.url.searchParams.get('plan') || 'monthly';
const prices = {
  monthly: 49000,
  yearly: 499000
};

// Handle form submission
if (Astro.request.method === 'POST') {
  try {
    const data = await Astro.request.formData();
    const userData = Astro.cookies.get('user')?.value;
    
    if (!userData) {
      return Astro.redirect('/akun?redirect=/checkout');
    }
    
    const user = JSON.parse(userData);
    await activatePremium(user.uid);
    
    return Astro.redirect('/subscription?success=true');
  } catch (error) {
    console.error('Error processing payment:', error);
  }
}

const price = prices[plan] || prices.monthly;
---

<Layout title="Checkout - AnimeTopia">
  <div class="min-h-screen py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-xl mx-auto">
      <div class="text-center mb-8">
        <h1 class="text-3xl font-bold">Checkout</h1>
        <p class="text-base-content/70 mt-2">Satu langkah lagi menuju akses premium tanpa batas</p>
      </div>
      
      <div class="card bg-base-200 shadow-xl">
        <div class="card-body">
          <!-- Order Summary -->
          <div class="mb-8">
            <h2 class="text-xl font-semibold mb-4">Ringkasan Pesanan</h2>
            <div class="flex justify-between items-center py-2 border-b border-base-300">
              <span>AnimeTopia Premium {plan === 'yearly' ? 'Yearly' : 'Monthly'}</span>
              <span class="font-semibold">Rp {price.toLocaleString('id-ID')}</span>
            </div>
            <div class="flex justify-between items-center py-2 border-b border-base-300">
              <span>Pajak</span>
              <span class="font-semibold">Rp {(price * 0.11).toLocaleString('id-ID')}</span>
            </div>
            <div class="flex justify-between items-center py-4 text-lg font-bold">
              <span>Total</span>
              <span>Rp {(price * 1.11).toLocaleString('id-ID')}</span>
            </div>
          </div>
          
          <!-- Payment Form -->
          <form method="POST" class="space-y-4">
            <div class="form-control">
              <label class="label">
                <span class="label-text">Nomor Kartu</span>
              </label>
              <input 
                type="text" 
                class="input input-bordered" 
                placeholder="1234 5678 9012 3456"
                pattern="[0-9\s]{13,19}"
                maxlength="19"
                required
              />
            </div>
            
            <div class="grid grid-cols-2 gap-4">
              <div class="form-control">
                <label class="label">
                  <span class="label-text">Tanggal Kadaluarsa</span>
                </label>
                <input 
                  type="text" 
                  class="input input-bordered" 
                  placeholder="MM/YY"
                  pattern="(0[1-9]|1[0-2])\/([0-9]{2})"
                  maxlength="5"
                  required
                />
              </div>
              
              <div class="form-control">
                <label class="label">
                  <span class="label-text">CVV</span>
                </label>
                <input 
                  type="text" 
                  class="input input-bordered" 
                  placeholder="123"
                  pattern="[0-9]{3,4}"
                  maxlength="4"
                  required
                />
              </div>
            </div>
            
            <div class="form-control">
              <label class="label">
                <span class="label-text">Nama di Kartu</span>
              </label>
              <input 
                type="text" 
                class="input input-bordered" 
                placeholder="NAMA LENGKAP"
                required
              />
            </div>
            
            <button type="submit" class="btn btn-primary w-full mt-6">
              Bayar Sekarang
            </button>
          </form>
          
          <!-- Secure Payment Notice -->
          <div class="mt-6 text-center text-sm text-base-content/70">
            <div class="flex justify-center items-center gap-2 mb-2">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z" clip-rule="evenodd" />
              </svg>
              Pembayaran Aman & Terenkripsi
            </div>
            <p>Kami tidak menyimpan data kartu kredit Anda</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  // Format card number input with spaces
  const cardInput = document.querySelector('input[placeholder="1234 5678 9012 3456"]');
  if (cardInput) {
    cardInput.addEventListener('input', (e) => {
      let value = e.target.value.replace(/\s/g, '');
      if (value.length > 0) {
        value = value.match(new RegExp('.{1,4}', 'g')).join(' ');
      }
      e.target.value = value;
    });
  }
  
  // Format expiry date input
  const expiryInput = document.querySelector('input[placeholder="MM/YY"]');
  if (expiryInput) {
    expiryInput.addEventListener('input', (e) => {
      let value = e.target.value.replace(/\D/g, '');
      if (value.length >= 2) {
        value = value.slice(0, 2) + '/' + value.slice(2);
      }
      e.target.value = value;
    });
  }
</script>

<style>
  input::-webkit-outer-spin-button,
  input::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }
  
  input[type=number] {
    -moz-appearance: textfield;
  }
  
  .input {
    font-family: monospace;
  }
</style> 