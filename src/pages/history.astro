---
import Layout from "~/layouts/Layout.astro";
---

<Layout title="Riwayat Tontonan - AnimeTopia">
  <div class="container mx-auto py-6 px-4">
    <h1 class="text-2xl font-bold mb-6">Riwayat Tontonan</h1>
    
    <div id="auth-warning" class="bg-yellow-100 border-l-4 border-yellow-500 text-yellow-700 p-4 mb-6 rounded">
      <div class="flex items-center">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
        </svg>
        <span>Anda perlu <a href="/akun" class="text-blue-600 underline">login</a> untuk melihat riwayat tontonan.</span>
      </div>
    </div>
    
    <div id="history-container" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 hidden">
      <!-- Skeleton loader untuk riwayat tontonan -->
      <div class="skeleton-loader">
        <div class="flex gap-4 p-4 bg-base-300 rounded-lg animate-pulse">
          <div class="w-24 h-32 bg-base-200 rounded"></div>
          <div class="flex flex-col gap-2 flex-1">
            <div class="h-6 w-3/4 bg-base-200 rounded"></div>
            <div class="h-4 w-1/2 bg-base-200 rounded"></div>
            <div class="h-4 w-2/3 bg-base-200 rounded"></div>
            <div class="h-6 w-24 bg-base-200 rounded mt-auto"></div>
          </div>
        </div>
      </div>
    </div>
    
    <!-- Empty state when no history -->
    <div id="empty-history" class="hidden text-center py-12">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-16 w-16 mx-auto text-gray-400 mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
      <h3 class="text-xl font-semibold mb-2">Belum Ada Riwayat</h3>
      <p class="text-gray-500 mb-6">Anda belum menonton anime apapun</p>
      <a href="/" class="btn btn-primary">Mulai Menonton</a>
    </div>
    
    <!-- Login required state -->
    <div id="login-required" class="hidden text-center py-12">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-16 w-16 mx-auto text-gray-400 mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
      </svg>
      <h3 class="text-xl font-semibold mb-2">Login diperlukan</h3>
      <p class="text-gray-500 mb-6">Anda perlu login untuk melihat riwayat tontonan</p>
      <a href="/akun" class="btn btn-primary">Login Sekarang</a>
    </div>
  </div>
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', async () => {
    const historyContainer = document.getElementById('history-container');
    const emptyHistory = document.getElementById('empty-history');
    const loginRequired = document.getElementById('login-required');
    const authWarning = document.getElementById('auth-warning');
    
    // Flag untuk mencegah multiple redundant renders
    let isLoading = false;

    // Import watch history utility in the background
    const watchHistoryPromise = import('/src/utils/watch-history.js');
    
    // Check if user is logged in
    function isAuthenticated() {
      try {
        const userData = localStorage.getItem('animetopia_user');
        if (!userData) return false;
        
        // Parse the data to ensure it's valid
        const user = JSON.parse(userData);
        return !!user && !!user.uid;
      } catch (error) {
        console.error('Error checking authentication status:', error);
        return false;
      }
    }
    
    // Initialize page and load history
    function initPage() {
      if (authWarning) {
        if (isAuthenticated()) {
          authWarning.classList.add('hidden');
        } else {
          authWarning.classList.remove('hidden');
        }
      }
      
      displayWatchHistory();
    }
    
    // Fungsi debounce untuk mencegah pemanggilan function berulang kali dalam waktu singkat
    function debounce(func, wait) {
      let timeout;
      return function executedFunction(...args) {
        const later = () => {
          clearTimeout(timeout);
          func(...args);
        };
        clearTimeout(timeout);
        timeout = setTimeout(later, wait);
      };
    }
    
    // Preload gambar di background untuk animasi yang lebih mulus
    function preloadImage(src) {
      return new Promise((resolve, reject) => {
        if (!src) {
          resolve(null);
          return;
        }
        const img = new Image();
        img.onload = () => resolve(img);
        img.onerror = () => resolve(null); // Resolve null instead of rejecting
        img.src = src;
      });
    }
    
    // Fungsi untuk menampilkan riwayat tontonan
    async function displayWatchHistory() {
      // Mencegah pemanggilan simultan
      if (isLoading) return;
      isLoading = true;
      
      try {
        // Check if user is logged in
        if (!isAuthenticated()) {
          if (historyContainer) historyContainer.classList.add('hidden');
          if (emptyHistory) emptyHistory.classList.add('hidden');
          if (loginRequired) loginRequired.classList.remove('hidden');
          if (authWarning) authWarning.classList.remove('hidden');
          isLoading = false;
          return;
        }
        
        // Hide login required message
        if (loginRequired) loginRequired.classList.add('hidden');
        if (authWarning) authWarning.classList.add('hidden');
        
        // Get watch history module
        const { getWatchHistory, removeFromWatchHistory } = await watchHistoryPromise;
        
        // Get watch history with the optimized utility
        const watchHistory = getWatchHistory();
        
        // Jika tidak ada riwayat, tampilkan pesan kosong
        if (!watchHistory || watchHistory.length === 0) {
          if (historyContainer) historyContainer.classList.add('hidden');
          if (emptyHistory) emptyHistory.classList.remove('hidden');
          isLoading = false;
          return;
        }
        
        // Show history container
        if (historyContainer) historyContainer.classList.remove('hidden');
        if (emptyHistory) emptyHistory.classList.add('hidden');
        
        // Preload gambar untuk 5 item pertama
        Promise.all(
          watchHistory.slice(0, 5).map(anime => 
            preloadImage(anime.image || 'https://via.placeholder.com/96x128?text=No+Image')
          )
        );
        
        // Hapus skeleton loader dan buat fragment
        const createHistoryItems = () => {
          const fragment = document.createDocumentFragment();
          
          watchHistory.forEach(anime => {
            const card = document.createElement('div');
            card.className = 'flex gap-4 p-4 bg-base-300 rounded-lg hover:bg-base-200 transition-colors history-item';
            card.dataset.id = anime.id;
            
            // Format tanggal
            const watchDate = new Date(anime.lastWatched);
            const formattedDate = watchDate.toLocaleDateString('id-ID', { 
              day: 'numeric', 
              month: 'short', 
              year: 'numeric' 
            });
            
            card.innerHTML = `
              <div class="w-24 h-32 flex-shrink-0 bg-base-100 rounded overflow-hidden">
                <img src="${anime.image}" alt="${anime.title}" class="w-full h-full object-cover" onerror="this.src='https://via.placeholder.com/96x128?text=No+Image'" loading="lazy">
              </div>
              <div class="flex flex-col gap-1 flex-1">
                <h3 class="font-bold line-clamp-1">${anime.title}</h3>
                <p class="text-sm text-gray-400">Episode ${anime.episode}</p>
                <p class="text-xs opacity-70">${formattedDate}</p>
                <div class="mt-auto flex gap-2">
                  <a href="/watch/${anime.id}/${anime.slug}?episode=${anime.episode}" class="btn btn-primary btn-sm">Lanjutkan</a>
                  <button class="remove-history btn btn-ghost btn-sm" data-id="${anime.id}">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
                      <path fill-rule="evenodd" d="M9 2a1 1 0 00-.894.553L7.382 4H4a1 1 0 000 2v10a2 2 0 002 2h8a2 2 0 002-2V6a1 1 0 100-2h-3.382l-.724-1.447A1 1 0 0011 2H9zM7 8a1 1 0 012 0v6a1 1 0 11-2 0V8zm5-1a1 1 0 00-1 1v6a1 1 0 102 0V8a1 1 0 00-1-1z" clip-rule="evenodd" />
                    </svg>
                  </button>
                </div>
              </div>
            `;
            
            fragment.appendChild(card);
          });
          
          // Hapus skeletons
          if (historyContainer) {
            historyContainer.innerHTML = '';
            historyContainer.appendChild(fragment);
          }
          
          // Tambahkan event listener untuk tombol hapus
          document.querySelectorAll('.remove-history').forEach(button => {
            button.addEventListener('click', (e) => {
              e.preventDefault();
              const animeId = e.currentTarget.dataset.id;
              if (!animeId) return;
              
              // Hapus dari history menggunakan utilitas baru
              removeFromWatchHistory(animeId);
              
              // Memberikan feedback visual cepat
              const historyItem = e.currentTarget.closest('.history-item');
              if (historyItem) {
                // Animasi fadeout
                historyItem.style.opacity = '0.5';
                historyItem.style.transform = 'translateX(10px)';
                
                // Hapus elemen setelah animasi
                setTimeout(() => {
                  historyItem.remove();
                  
                  // Cek jika history kosong
                  if (historyContainer && historyContainer.children.length === 0) {
                    historyContainer.classList.add('hidden');
                    if (emptyHistory) emptyHistory.classList.remove('hidden');
                  }
                }, 300);
              }
            });
          });
        };
        
        // Beri kesempatan browser untuk melakukan rendering
        window.requestAnimationFrame(createHistoryItems);
        
      } catch (error) {
        console.error("Error displaying watch history:", error);
      } finally {
        isLoading = false;
      }
    }
    
    // Tampilkan riwayat dengan minimal delay
    requestAnimationFrame(initPage);
    
    // Tambahkan event listener untuk perubahan storage
    window.addEventListener('storage', debounce((e) => {
      if (e.key === 'animetopia_user' || e.key?.startsWith('animeWatchHistory')) {
        initPage();
      }
    }, 300));
    
    // Also run after Astro view transitions
    document.addEventListener('astro:page-load', initPage);
    document.addEventListener('astro:after-swap', initPage);
  });
</script>

<style>
  .history-item {
    transition: opacity 0.3s ease, transform 0.3s ease;
    will-change: opacity, transform;
  }
  
  .skeleton-loader {
    animation: pulse 2s cubic-bezier(.4,0,.6,1) infinite;
  }
  
  @keyframes pulse {
    0%, 100% {
      opacity: 1;
    }
    50% {
      opacity: 0.7;
    }
  }
</style> 