---
export const prerender = false;
import Layout from "~/layouts/Layout.astro";
import Table from "~/components/ui/Table.astro";
import { fetchAnimeData } from "~/utils/api";

const { id, slug } = Astro.params;
const episode = Astro.url.searchParams.get("episode") ?? null;

let data = null;
let isError = false;

try {
  const res = await fetchAnimeData(id, slug);
  if (!res) {
    isError = true;
  } else {
    data = res;
  }
} catch (error) {
  console.error("Error fetching anime data:", error);
  isError = true;
}

// Ekstrak data episode dengan aman
const episodes = data?.results?.episode || [];
const totalEp = episodes?.at?.(-1) ?? 1;
const isFinished = data?.results?.details?.[2]?.data?.includes?.("Selesai") || false;
const checkEpSelesai = episode ?? (isFinished ? episodes[0] : totalEp);
---

<Layout title={`${data?.results?.title || "Loading..."} - AnimeTopia`}>
  <div class="py-4">
    <h1 class="text-xl font-bold mb-2">{data?.results?.title || "Loading..."}</h1>
  
  <div class="grid grid-cols-1 gap-2 my-2">
    <!-- Hidden inputs for JavaScript -->
    <input id="episode" type="hidden" value={checkEpSelesai} />
      <input id="anime-data-available" type="hidden" value={String(!isError)} />
    
    <!-- Episode Selection Panel -->
    <div class="bg-base-300 rounded-lg p-3 mb-2">
      <div class="flex justify-between items-center mb-2">
        <h2 class="text-lg font-bold">Episode List</h2>
          <div class="flex items-center gap-2">
            <span class="text-sm opacity-70">Episode saat ini: {checkEpSelesai}</span>
          <div class="badge badge-primary">{episodes.length} episode</div>
        </div>
      </div>
      
        <!-- Episode grid -->
        <div class="episode-container bg-base-200 rounded-lg p-2 overflow-x-auto grid grid-cols-5 gap-2">
          {episodes.map((ep) => (
            <a 
              href={`/watch/${id}/${slug}?episode=${ep}`}
                  data-episode={ep} 
              class={`btn btn-sm ${ep === checkEpSelesai ? 'btn-primary' : 'btn-ghost'}`}
                >
                  {ep}
                </a>
          ))}
      </div>
    </div>
    
      <!-- Video Player -->
      <div class="relative aspect-video bg-base-300 rounded-lg overflow-hidden">
          <div
            id="player"
            data-poster={data?.results?.image || ""}
            data-storage="player-storage"
          data-autoplay="false"
          data-preload="true"
          class="w-full h-full"
          >
          </div>
        <div id="player-info" class="absolute inset-0 flex items-center justify-center">
          <div class="loading">Memuat video player...</div>
            </div>
          </div>
    </div>
    
    <!-- Anime Details -->
    <div class="mt-4">
      <h1 class="text-center text-2xl font-bold mb-4">{data?.results?.title}</h1>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="bg-base-300 rounded-lg p-4">
          <Table data={data?.results?.details || []} />
        </div>
        <div class="bg-base-300 rounded-lg p-4">
          <h2 class="text-lg font-bold mb-2">Sinopsis</h2>
          <p set:html={data?.results?.description} class="text-sm opacity-90"></p>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  import { initWatchPlayer } from "~/scripts/watch";

  function setupPlayer() {
    const playerElement = document.getElementById('player');
    const playerInfo = document.getElementById('player-info');
    const episode = document.getElementById('episode')?.value;
    const animeDataAvailable = document.getElementById('anime-data-available')?.value === 'true';

    if (!playerElement || !playerInfo || !episode || !animeDataAvailable) {
      if (playerInfo) {
        playerInfo.innerHTML = `
          <div class="text-center">
            <p class="text-error mb-2">Data tidak tersedia</p>
            <button onclick="window.location.reload()" class="btn btn-error btn-sm">
              Coba lagi
            </button>
          </div>
        `;
      }
      return;
    }

    try {
      initWatchPlayer(playerElement, episode);
      if (playerInfo) playerInfo.style.display = 'none';
      } catch (error) {
      console.error('Error initializing player:', error);
      if (playerInfo) {
        playerInfo.innerHTML = `
          <div class="text-center">
            <p class="text-error mb-2">Gagal memuat video player</p>
            <button onclick="window.location.reload()" class="btn btn-error btn-sm">
              Coba lagi
            </button>
          </div>
        `;
      }
    }
  }

  // Initialize player when DOM is ready
  document.addEventListener('DOMContentLoaded', setupPlayer);
  document.addEventListener('astro:after-swap', setupPlayer);
</script>

<style>
  .loading {
    @apply text-center p-4;
  }
  
  .episode-container {
    grid-template-columns: repeat(auto-fill, minmax(60px, 1fr));
    max-height: 200px;
    overflow-y: auto;
  }

  @media (max-width: 640px) {
    .episode-container {
      grid-template-columns: repeat(auto-fill, minmax(45px, 1fr));
    }
  }
</style>