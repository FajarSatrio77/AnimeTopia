---
import Layout from "~/layouts/Layout.astro";
import { getSubscriptionDetails } from "~/utils/subscription";

// Get subscription status if user is logged in
let subscriptionDetails = null;
if (Astro.cookies.has('user')) {
  try {
    const userData = JSON.parse(Astro.cookies.get('user').value);
    if (userData?.uid) {
      subscriptionDetails = await getSubscriptionDetails(userData.uid);
    }
  } catch (error) {
    console.error('Error getting subscription details:', error);
  }
}
---

<Layout title="Premium Subscription - AnimeTopia">
  <div class="min-h-screen py-12 px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12">
      <h1 class="text-4xl font-bold mb-4 bg-gradient-to-r from-pink-500 via-purple-500 to-indigo-500 bg-clip-text text-transparent">
        Upgrade to Premium
      </h1>
      <p class="text-lg text-base-content/70 max-w-2xl mx-auto">
        Nikmati akses tanpa batas ke semua episode anime favoritmu dengan berlangganan Premium
      </p>
    </div>

    <div class="max-w-7xl mx-auto">
      <!-- Pricing Cards -->
      <div class="grid md:grid-cols-3 gap-8 items-start">
        <!-- Basic Plan -->
        <div class="card bg-base-200 shadow-xl">
          <div class="card-body">
            <h2 class="card-title justify-center text-2xl mb-2">Basic</h2>
            <div class="text-center mb-4">
              <span class="text-3xl font-bold">Free</span>
            </div>
            <ul class="space-y-3">
              <li class="flex items-center">
                <svg class="h-5 w-5 text-green-500 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
                Akses episode 1 setiap anime
              </li>
              <li class="flex items-center text-base-content/70">
                <svg class="h-5 w-5 text-red-500 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                </svg>
                Episode lanjutan terkunci
              </li>
              <li class="flex items-center text-base-content/70">
                <svg class="h-5 w-5 text-red-500 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                </svg>
                Iklan muncul
              </li>
            </ul>
            <div class="card-actions justify-center mt-6">
              <button class="btn btn-outline" disabled>Current Plan</button>
            </div>
          </div>
        </div>

        <!-- Premium Plan -->
        <div class="card bg-gradient-to-br from-primary/10 to-secondary/10 shadow-xl transform md:scale-105 border-2 border-primary/20">
          <div class="absolute -top-5 left-1/2 transform -translate-x-1/2">
            <span class="badge badge-primary">RECOMMENDED</span>
          </div>
          <div class="card-body">
            <h2 class="card-title justify-center text-2xl mb-2">Premium</h2>
            <div class="text-center mb-4">
              <span class="text-3xl font-bold">Rp 49.000</span>
              <span class="text-base-content/70">/bulan</span>
            </div>
            <ul class="space-y-3">
              <li class="flex items-center">
                <svg class="h-5 w-5 text-green-500 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
                Akses semua episode tanpa batas
              </li>
              <li class="flex items-center">
                <svg class="h-5 w-5 text-green-500 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
                Bebas iklan
              </li>
              <li class="flex items-center">
                <svg class="h-5 w-5 text-green-500 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
                Kualitas video HD
              </li>
            </ul>
            <div class="card-actions justify-center mt-6">
              {subscriptionDetails?.isPremium ? (
                <button class="btn btn-primary" disabled>Current Plan</button>
              ) : (
                <a href="/checkout" class="btn btn-primary">Upgrade Now</a>
              )}
            </div>
          </div>
        </div>

        <!-- Premium Yearly Plan -->
        <div class="card bg-base-200 shadow-xl">
          <div class="card-body">
            <h2 class="card-title justify-center text-2xl mb-2">Premium Yearly</h2>
            <div class="text-center mb-4">
              <span class="text-3xl font-bold">Rp 499.000</span>
              <span class="text-base-content/70">/tahun</span>
              <div class="badge badge-secondary mt-2">Save 15%</div>
            </div>
            <ul class="space-y-3">
              <li class="flex items-center">
                <svg class="h-5 w-5 text-green-500 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
                Semua fitur Premium
              </li>
              <li class="flex items-center">
                <svg class="h-5 w-5 text-green-500 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
                Hemat 15%
              </li>
              <li class="flex items-center">
                <svg class="h-5 w-5 text-green-500 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
                Prioritas dukungan
              </li>
            </ul>
            <div class="card-actions justify-center mt-6">
              <a href="/checkout?plan=yearly" class="btn btn-outline btn-primary">Choose Plan</a>
            </div>
          </div>
        </div>
      </div>

      <!-- FAQ Section -->
      <div class="mt-20">
        <h2 class="text-3xl font-bold text-center mb-8">Frequently Asked Questions</h2>
        <div class="grid gap-4 max-w-3xl mx-auto">
          <div class="collapse collapse-plus bg-base-200">
            <input type="radio" name="faq" checked="checked" /> 
            <div class="collapse-title text-xl font-medium">
              Apa itu AnimeTopia Premium?
            </div>
            <div class="collapse-content">
              <p>AnimeTopia Premium adalah layanan berlangganan yang memberikan akses tanpa batas ke semua episode anime di platform kami. Dengan Premium, Anda dapat menonton semua episode tanpa batasan dan menikmati streaming bebas iklan.</p>
            </div>
          </div>
          <div class="collapse collapse-plus bg-base-200">
            <input type="radio" name="faq" /> 
            <div class="collapse-title text-xl font-medium">
              Bagaimana cara berlangganan Premium?
            </div>
            <div class="collapse-content">
              <p>Pilih paket Premium yang Anda inginkan, klik tombol "Upgrade Now" atau "Choose Plan", dan ikuti petunjuk pembayaran. Setelah pembayaran berhasil, akun Anda akan langsung diaktifkan sebagai Premium.</p>
            </div>
          </div>
          <div class="collapse collapse-plus bg-base-200">
            <input type="radio" name="faq" /> 
            <div class="collapse-title text-xl font-medium">
              Apakah saya bisa membatalkan langganan?
            </div>
            <div class="collapse-content">
              <p>Ya, Anda dapat membatalkan langganan kapan saja melalui halaman pengaturan akun. Setelah dibatalkan, Anda masih dapat menikmati fitur Premium sampai akhir periode langganan.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>

<style>
  .card {
    @apply transition-all duration-300;
  }
  
  .card:hover {
    @apply transform -translate-y-2;
  }
  
  .btn-primary {
    @apply shadow-lg shadow-primary/30;
  }
</style> 