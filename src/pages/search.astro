---
export const prerender = false;
import Layout from "~/layouts/Layout.astro";
import Card from "~/components/ui/Card.astro";
import { fetchData } from "~/utils/api";

// Get search query from URL
const query = Astro.url.searchParams.get("q") || "";
const searchResults = query ? await fetchData(`search?q=${encodeURIComponent(query)}`) : null;
---

<Layout title={`Search: ${query} - AnimeTopia`}>
  <div class="my-6">
    <form class="form-control w-full max-w-2xl mx-auto mb-8">
      <div class="input-group">
        <input 
          type="text" 
          name="q" 
          placeholder="Cari anime..." 
          class="input input-bordered w-full" 
          value={query}
          autofocus
        />
        <button class="btn btn-primary">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-5 w-5"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"
            ></path>
          </svg>
          Cari
        </button>
      </div>
    </form>

    {query && (
      <h2 class="text-xl font-bold mb-4">Hasil pencarian untuk: {query}</h2>
    )}

    {!query && (
      <div class="text-center py-10">
        <h2 class="text-xl font-bold mb-2">Cari Anime Favorit Anda</h2>
        <p class="text-base-content/70">Masukkan judul anime untuk memulai pencarian</p>
      </div>
    )}

    {query && searchResults?.results?.length === 0 && (
      <div class="text-center py-10">
        <h3 class="text-lg font-bold">Tidak ada hasil yang ditemukan</h3>
        <p class="text-base-content/70">Coba cari dengan kata kunci lain</p>
      </div>
    )}

    <div id="content" class="grid grid-cols-2 md:grid-cols-4 gap-2 md:gap-4">
      {searchResults?.results && <Card data={searchResults.results} />}
    </div>
  </div>
</Layout> 