---
import Layout from "~/layouts/Layout.astro";
---

<Layout title="Profil - AnimeTopia">
  <div class="container mx-auto px-4 py-8">
    <div class="max-w-2xl mx-auto">
      <div class="card bg-base-100 shadow-xl">
        <div class="card-body">
          <h2 class="card-title text-2xl mb-4">Profil Pengguna</h2>
          
          <div class="stats shadow">
            <div class="stat">
              <div class="stat-figure text-primary">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="24"
                  height="24"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="lucide lucide-heart"
                >
                  <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z" />
                </svg>
              </div>
              <div class="stat-title">Anime Favorit</div>
              <div class="stat-value text-primary" id="favorites-count">0</div>
              <div class="stat-actions">
                <a href="/favorites" class="btn btn-primary btn-sm">Lihat Favorit</a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    // Update favorites count
    function updateFavoritesCount() {
      const favorites = JSON.parse(localStorage.getItem('favorites') || '[]');
      const countElement = document.getElementById('favorites-count');
      if (countElement) {
        countElement.textContent = favorites.length;
      }
    }

    // Update count when page loads
    updateFavoritesCount();
    
    // Listen for storage changes to update count
    window.addEventListener('storage', updateFavoritesCount);
  </script>
</Layout> 