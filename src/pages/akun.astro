---
import Layout from "~/layouts/Layout.astro";
---

<Layout title="Login - AnimeTopia" hideHeader={true}>
  <!-- Custom header without search -->
  <div class="sticky top-0 left-0 right-0 navbar bg-base-100/90 backdrop-blur shadow-sm z-10 rounded-b-lg">
    <div class="navbar-start">
      <div class="dropdown">
        <!-- Empty dropdown for spacing -->
      </div>
    </div>
    <div class="navbar-center">
      <a href="/" class="btn btn-ghost text-xl">AnimeTopia</a>
    </div>
    <div class="navbar-end">
      <!-- Empty end for spacing -->
    </div>
  </div>

  <div class="anime-login-container min-h-screen py-12 px-4 relative">
    <!-- Anime elements background -->
    <div class="anime-decoration-elements">
      <div class="sakura-petal petal-1"></div>
      <div class="sakura-petal petal-2"></div>
      <div class="sakura-petal petal-3"></div>
      <div class="sakura-petal petal-4"></div>
      <div class="sakura-petal petal-5"></div>
      <div class="sakura-petal petal-6"></div>
      <div class="sakura-petal petal-7"></div>
      <div class="sakura-petal petal-8"></div>
      <div class="sakura-petal petal-9"></div>
      <div class="sakura-petal petal-10"></div>
    </div>
    
    <!-- Main container -->
    <div class="container mx-auto max-w-md relative z-10">
      <div class="main-container">
        <!-- Anime character decoration -->
        <div class="anime-character"></div>
        
        <!-- User Profile Card (shown when logged in) -->
        <div id="profile-card" class="card-3d-wrapper hidden">
          <div class="card-front">
            <div class="center-wrap">
              <div class="card-header text-center mb-6">
                <h2 class="text-2xl font-bold mb-1 text-white">Profil Pengguna</h2>
                <p class="text-sm text-indigo-200/70">Anda telah login</p>
              </div>
              
              <div class="user-avatar mb-4">
                <div class="avatar-circle">
                  <span id="profile-initial" class="avatar-text">U</span>
                </div>
              </div>
              
              <div class="user-info text-center mb-8">
                <h3 id="profile-display-name" class="text-xl font-semibold text-white mb-1">Username</h3>
                <p id="profile-email" class="text-sm text-indigo-200/70">user@example.com</p>
              </div>
              
              <div class="stats grid grid-cols-3 gap-4 mb-8">
                <div class="stat bg-indigo-800/30 p-3 rounded-lg text-center">
                  <p class="text-xs text-indigo-200/70">Ditonton</p>
                  <p class="text-xl font-bold text-white">0</p>
                </div>
                <div class="stat bg-indigo-800/30 p-3 rounded-lg text-center">
                  <p class="text-xs text-indigo-200/70">Favorit</p>
                  <p class="text-xl font-bold text-white" id="favorites-count">0</p>
                  <a href="/favorites" class="text-xs text-indigo-300 hover:text-white transition-colors mt-1 block">Lihat Favorit</a>
                </div>
                <div class="stat bg-indigo-800/30 p-3 rounded-lg text-center">
                  <p class="text-xs text-indigo-200/70">Ditandai</p>
                  <p class="text-xl font-bold text-white">0</p>
                </div>
              </div>
              
              <button id="logout-button" class="btn-logout w-full">
                LOGOUT
              </button>
              
              <div class="links mt-6 text-center">
                <a href="/" class="text-xs text-indigo-200/70 hover:text-white transition-colors">Kembali ke Beranda</a>
              </div>
            </div>
          </div>
        </div>
        
        <!-- Form Cards Container with perspective effect -->
        <div class="forms-container perspective">
          <!-- Login Card -->
          <div id="login-card" class="card-3d-wrapper">
            <div class="card-front">
              <div class="center-wrap">
                <div class="card-header text-center mb-4">
                  <h2 class="text-2xl font-bold mb-1 text-white">Welcome Back</h2>
                  <p class="text-sm text-pink-200/70">Login to your anime journey</p>
                </div>
                
                <form id="login-form" class="space-y-5">
                  <div class="form-group">
                    <input type="email" id="email" name="email" 
                      class="form-control" placeholder="Email" required>
                    <i class="input-icon uil uil-at"></i>
                  </div>
                  
                  <div class="form-group">
                    <input type="password" id="password" name="password" 
                      class="form-control" placeholder="Password" required>
                    <i class="input-icon uil uil-lock-alt"></i>
                  </div>
                  
                  <div class="text-right">
                    <a href="#" class="text-xs text-pink-300 hover:text-white transition-colors">Forgot Password?</a>
                  </div>
                  
                  <div class="hidden bg-red-900/50 text-red-200 text-sm p-3 rounded-lg border border-red-500/50 mt-4" id="login-error">
                    <div class="flex items-center">
                      <svg class="h-5 w-5 mr-2 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd"></path>
                      </svg>
                      <span>Username atau password salah</span>
                    </div>
                  </div>
                  
                  <button type="submit" id="login-button" class="btn-login">
                    LOGIN
                  </button>
                  
                  <div class="social-login">
                    <p class="text-center text-xs text-white/50 mb-3">Or sign in with</p>
                    <div class="social-icons">
                      <a href="#" class="social-icon">
                        <i class="fab fa-facebook-f"></i>
                      </a>
                      <a href="#" class="social-icon">
                        <i class="fab fa-twitter"></i>
                      </a>
                      <a href="#" class="social-icon">
                        <i class="fab fa-google"></i>
                      </a>
                    </div>
                  </div>
                  
                  <p class="text-center mt-6 text-white/70 text-sm">
                    Not a member? 
                    <a href="#" id="show-register" class="text-pink-400 hover:text-pink-300">Sign up now</a>
                  </p>
                </form>
              </div>
            </div>
          </div>
          
          <!-- Register Card -->
          <div id="register-card" class="card-3d-wrapper hidden">
            <div class="card-front">
              <div class="center-wrap">
                <div class="card-header text-center mb-4">
                  <h2 class="text-2xl font-bold mb-1 text-white">Join AnimeTopia</h2>
                  <p class="text-sm text-indigo-200/70">Create your account</p>
                </div>
                
                <form id="register-form" class="space-y-5">
                  <div class="form-group">
                    <input type="text" id="reg-username" name="username" 
                      class="form-control" placeholder="Username" required>
                    <i class="input-icon uil uil-user"></i>
                  </div>
                  
                  <div class="form-group">
                    <input type="email" id="reg-email" name="email" 
                      class="form-control" placeholder="Email" required>
                    <i class="input-icon uil uil-at"></i>
                  </div>
                  
                  <div class="form-group">
                    <input type="password" id="reg-password" name="password" 
                      class="form-control" placeholder="Password" required>
                    <i class="input-icon uil uil-lock-alt"></i>
                  </div>
                  
                  <div class="form-group">
                    <input type="password" id="reg-confirm-password" name="confirm_password" 
                      class="form-control" placeholder="Confirm Password" required>
                    <i class="input-icon uil uil-lock-access"></i>
                  </div>
                  
                  <div class="hidden bg-red-900/50 text-red-200 text-sm p-3 rounded-lg border border-red-500/50 mt-4" id="register-error">
                    <div class="flex items-center">
                      <svg class="h-5 w-5 mr-2 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd"></path>
                      </svg>
                      <span>Username atau email sudah digunakan</span>
                    </div>
                  </div>
                  
                  <div class="flex items-center space-x-2 ml-1">
                    <input id="remember-me" name="remember-me" type="checkbox" 
                      class="w-4 h-4 text-indigo-500 bg-transparent border-2 border-white/30 rounded focus:ring-0">
                    <label for="remember-me" class="text-sm text-white/70">Remember me</label>
                  </div>
                  
                  <button type="submit" id="register-button" class="btn-register">
                    SIGN UP
                  </button>
                  
                  <p class="text-center mt-6 text-white/70 text-sm">
                    Already a member? 
                    <a href="#" id="show-login" class="text-indigo-400 hover:text-indigo-300">Sign in</a>
                  </p>
                </form>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script is:inline>
  // Script untuk menangani toggle antara form
  document.addEventListener('DOMContentLoaded', () => {
    console.log("DOM Animation Script Loaded");
    
    // DOM elements
    const loginCard = document.getElementById('login-card');
    const registerCard = document.getElementById('register-card');
    const showRegisterBtn = document.getElementById('show-register');
    const showLoginBtn = document.getElementById('show-login');
    const directRegisterBtn = document.getElementById('direct-register-btn');
    
    console.log("Elements found:", { 
      loginCard: !!loginCard, 
      registerCard: !!registerCard, 
      showRegisterBtn: !!showRegisterBtn, 
      showLoginBtn: !!showLoginBtn,
      directRegisterBtn: !!directRegisterBtn
    });
    
    // Function to switch to register form
    function showRegisterForm() {
      if (!loginCard || !registerCard) {
        console.error("Cards not found for switching to register");
        return;
      }
      
      console.log("Switching to register form");
      
      // Hide login card and profile card if it exists
      loginCard.classList.add('hidden');
      const profileCard = document.getElementById('profile-card');
      if (profileCard) {
        profileCard.classList.add('hidden');
      }
      
      // Show register card
      registerCard.classList.remove('hidden');
    }
    
    // Function to switch to login form
    function showLoginForm() {
      if (!loginCard || !registerCard) {
        console.error("Cards not found for switching to login");
        return;
      }
      
      console.log("Switching to login form from inline script");
      
      // Hide register card
      registerCard.classList.add('hidden');
      
      // Show login card
      loginCard.classList.remove('hidden');
    }
    
    // Register button click handler
    if (showRegisterBtn) {
      showRegisterBtn.addEventListener('click', function(e) {
        e.preventDefault();
        console.log("Register button clicked");
        console.log("Register card before:", registerCard ? registerCard.className : "null");
        console.log("Login card before:", loginCard ? loginCard.className : "null");
        
        showRegisterForm();
        
        console.log("Register card after:", registerCard ? registerCard.className : "null");
        console.log("Login card after:", loginCard ? loginCard.className : "null");
      });
    } else {
      console.error("Show register button not found");
    }
    
    // Login button click handler
    if (showLoginBtn) {
      showLoginBtn.addEventListener('click', function(e) {
        e.preventDefault();
        console.log("Login button clicked");
        showLoginForm();
      });
    } else {
      console.error("Show login button not found");
    }
    
    // Direct register button handler (in navbar)
    if (directRegisterBtn) {
      directRegisterBtn.addEventListener('click', function(e) {
        e.preventDefault();
        console.log("Direct register button clicked");
        console.log("Register card before:", registerCard ? registerCard.className : "null");
        console.log("Login card before:", loginCard ? loginCard.className : "null");
        
        showRegisterForm();
        
        console.log("Register card after:", registerCard ? registerCard.className : "null");
        console.log("Login card after:", loginCard ? loginCard.className : "null");
      });
    }
    
    // Expose these functions globally so they can be used by other scripts
    window.showRegisterForm = showRegisterForm;
    window.showLoginForm = showLoginForm;
  });
</script>

<script>
  // Import auth functions
  import { signUpUser, loginUser, getCurrentUser, checkApiConnection, setupAuthStateListener, logoutUser } from "../utils/auth.js";
  
  document.addEventListener('DOMContentLoaded', async () => {
    console.log("Auth Script Loaded");
    
    // Check if API is reachable
    const apiConnected = await checkApiConnection();
    if (!apiConnected) {
      console.error("API tidak dapat dijangkau. Mungkin server tidak berjalan atau ada masalah routing.");
      // Tampilkan pesan di halaman
      const apiErrorMsg = document.createElement('div');
      apiErrorMsg.className = 'bg-red-500 text-white p-3 text-center fixed top-0 left-0 right-0 z-50';
      apiErrorMsg.innerHTML = 'Koneksi ke server API gagal. Pastikan XAMPP berjalan dan server Astro aktif.';
      document.body.prepend(apiErrorMsg);
    }
    
    // DOM elements for forms
    const loginForm = document.getElementById('login-form');
    const registerForm = document.getElementById('register-form');
    const loginError = document.getElementById('login-error');
    const registerError = document.getElementById('register-error');
    const profileCard = document.getElementById('profile-card');
    const loginCard = document.getElementById('login-card');
    const registerCard = document.getElementById('register-card');
    
    // Function to update profile UI with user data
    async function updateProfileUI(userData) {
      if (!userData || !profileCard) return;
      
      console.log("Updating profile UI with data:", userData);
      
      const profileInitial = document.getElementById('profile-initial');
      const profileDisplayName = document.getElementById('profile-display-name');
      const profileEmail = document.getElementById('profile-email');
      const favoritesCount = document.getElementById('favorites-count');
      
      if (profileInitial) {
        profileInitial.textContent = userData.nama ? userData.nama.charAt(0).toUpperCase() : 'U';
      }
      
      if (profileDisplayName) {
        profileDisplayName.textContent = userData.nama || 'User';
      }
      
      if (profileEmail) {
        profileEmail.textContent = userData.email || '';
      }

      // Update favorites count
      if (favoritesCount) {
        const favorites = JSON.parse(localStorage.getItem('favorites') || '[]');
        favoritesCount.textContent = favorites.length;
      }
    }
    
    // Function to show profile
    async function showProfileCard() {
      if (!profileCard || !loginCard || !registerCard) return;
      
      // Get user data from localStorage first
      const storedUser = localStorage.getItem('animetopia_user');
      if (storedUser) {
        const userData = JSON.parse(storedUser);
        console.log("Found stored user data:", userData);
      
      // Hide other cards
      loginCard.classList.add('hidden');
      registerCard.classList.add('hidden');
      
      // Show profile card
      profileCard.classList.remove('hidden');
      
        // Update profile UI
        await updateProfileUI(userData);
        return;
      }
      
      // If no stored user data, show login form
      showLoginForm();
    }

    // Function to show login form
    function showLoginForm() {
      if (!loginCard || !registerCard || !profileCard) return;
      
      // Hide other cards
      registerCard.classList.add('hidden');
      profileCard.classList.add('hidden');
      
      // Show login card
      loginCard.classList.remove('hidden');
    }
    
    // Check if user is already logged in
    const storedUser = localStorage.getItem('animetopia_user');
    console.log("Checking stored user:", storedUser);
    
    if (storedUser) {
      // User is logged in, show profile
      await showProfileCard();
      } else {
      // No logged in user, show login form
          showLoginForm();
        }

    // Handle logout button click
    const logoutButton = document.getElementById('logout-button');
    if (logoutButton) {
      logoutButton.addEventListener('click', async () => {
        localStorage.removeItem('animetopia_user');
        localStorage.clear();
        window.location.href = '/akun';
      });
    }
    
    // Handle login form submission
    if (loginForm) {
      loginForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        
        const emailElement = document.getElementById('email') as HTMLInputElement;
        const passwordElement = document.getElementById('password') as HTMLInputElement;
        const loginButton = document.getElementById('login-button') as HTMLButtonElement;
        
        if (!emailElement || !passwordElement) {
          console.error("Email or password element not found");
          return;
        }
        
        const email = emailElement.value.trim();
        const password = passwordElement.value.trim();
        
        if (!email || !password) {
          if (loginError) {
            const spanElement = loginError.querySelector('span');
            if (spanElement) {
              spanElement.textContent = 'Email dan password harus diisi';
            }
            loginError.classList.remove('hidden');
          }
          return;
        }
        
        try {
          // Disable login button and show loading state
          if (loginButton) {
            loginButton.disabled = true;
            loginButton.textContent = 'Loading...';
          }
          
          console.log("Attempting login for:", email);
          const loginResult = await loginUser(email, password);
          
          if (loginResult.success) {
            console.log("Login successful, redirecting to ongoing page...");
            // Simpan data user ke localStorage
            localStorage.setItem('animetopia_user', JSON.stringify(loginResult.user));
            // Redirect ke halaman ongoing
            window.location.href = '/';
          } else {
            console.log("Login failed:", loginResult.message);
            if (loginError) {
            const spanElement = loginError.querySelector('span');
            if (spanElement) {
                spanElement.textContent = loginResult.message || 'Email atau password salah';
            }
            loginError.classList.remove('hidden');
            }
          }
        } catch (error) {
          console.error("Login error:", error);
          if (loginError) {
            const spanElement = loginError.querySelector('span');
            if (spanElement) {
              spanElement.textContent = 'Terjadi kesalahan saat login. Silakan coba lagi.';
            }
            loginError.classList.remove('hidden');
          }
        } finally {
          // Re-enable login button
          if (loginButton) {
            loginButton.disabled = false;
            loginButton.textContent = 'LOGIN';
          }
        }
      });
    }
    
    // Setup auth state listener
    const unsubscribe = setupAuthStateListener((user) => {
      if (user) {
        // Tampilkan profile jika di halaman login
        if (window.location.pathname === '/akun') {
          showProfileCard();
        }
      } else {
        // User telah logout, tampilkan form login
        if (window.location.pathname === '/akun') {
          showLoginForm();
        }
      }
    });
    
    // Handle register form submission
    if (registerForm) {
      registerForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        
        console.log("Form submission started...");
        
        const usernameElement = document.getElementById('reg-username') as HTMLInputElement;
        const emailElement = document.getElementById('reg-email') as HTMLInputElement;
        const passwordElement = document.getElementById('reg-password') as HTMLInputElement;
        const confirmPasswordElement = document.getElementById('reg-confirm-password') as HTMLInputElement;
        
        if (!usernameElement || !emailElement || !passwordElement || !confirmPasswordElement || !registerError) {
          console.error("One or more registration form elements not found");
          return;
        }
        
        const username = usernameElement.value || "";
        const email = emailElement.value || "";
        const password = passwordElement.value || "";
        const confirmPassword = confirmPasswordElement.value || "";
        
        console.log("Form data collected:", { 
          username: username, 
          email: email,
          hasPassword: !!password, 
          passwordsMatch: password === confirmPassword 
        });
        
        // Basic validation
        if (!username || !email || !password || !confirmPassword) {
          const spanElement = registerError.querySelector('span');
          if (spanElement) {
            spanElement.textContent = 'Semua field harus diisi';
          }
          registerError.classList.remove('hidden');
          console.log("Validation failed: Empty fields");
          return;
        }
        
        // Email validation
        const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
        if (!emailRegex.test(email)) {
          const spanElement = registerError.querySelector('span');
          if (spanElement) {
            spanElement.textContent = 'Format email tidak valid';
          }
          registerError.classList.remove('hidden');
          console.log("Validation failed: Invalid email format");
          return;
        }
        
        // Check if passwords match
        if (password !== confirmPassword) {
          const spanElement = registerError.querySelector('span');
          if (spanElement) {
            spanElement.textContent = 'Password tidak cocok';
          }
          registerError.classList.remove('hidden');
          console.log("Validation failed: Passwords don't match");
          return;
        }
        
        try {
          console.log("Attempting registration for:", username, email);
          registerError.classList.add('hidden'); // Hide any previous error
          
          // Tambahkan loading state
          const registerButton = document.getElementById('register-button');
          if (registerButton) {
            registerButton.textContent = "Mendaftar...";
            registerButton.setAttribute('disabled', 'true');
          }
          
          // Gunakan signUpUser untuk Firebase
          const user = await signUpUser(email, password, username);
          
          console.log("Registration successful:", user);
          
          // Kembalikan tombol ke keadaan semula
          if (registerButton) {
            registerButton.textContent = "SIGN UP";
            registerButton.removeAttribute('disabled');
          }
          
            // Show success message
            alert('Pendaftaran berhasil! Silakan login.');
            
            // Pre-fill login form with the registered email for convenience
            const emailInput = document.getElementById('email') as HTMLInputElement;
            if (emailInput) {
              emailInput.value = email;
            }
            
          // Switch to login view
            showLoginForm();
          
        } catch (error) {
          console.error("Registration error:", error);
          
          // Kembalikan tombol ke keadaan semula
          const registerButton = document.getElementById('register-button');
          if (registerButton) {
            registerButton.textContent = "SIGN UP";
            registerButton.removeAttribute('disabled');
          }
          
          if (registerError) {
            const spanElement = registerError.querySelector('span');
            if (spanElement) {
              spanElement.textContent = error.message || 'Terjadi kesalahan saat pendaftaran. Silakan coba lagi.';
            }
            registerError.classList.remove('hidden');
          }
        }
      });
    }
    
    // Add event listener for profile menu click
    document.addEventListener('click', async (e) => {
      const target = e.target as HTMLElement;
      const profileLink = target.closest('a[href="/akun"]');
      
      if (profileLink) {
        e.preventDefault();
        const storedUser = localStorage.getItem('animetopia_user');
        
        if (storedUser) {
          // User is logged in, show profile
          await showProfileCard();
        } else {
          // No logged in user, show login form
          showLoginForm();
        }
        
        // Navigate to profile page
        window.location.href = '/akun';
      }
    });
    
    // Add event listener for page load
    window.addEventListener('load', async () => {
      const storedUser = localStorage.getItem('animetopia_user');
      if (storedUser && window.location.pathname === '/akun') {
        await showProfileCard();
      }
    });
    
    // Add event listener for storage changes to update favorites count
    window.addEventListener('storage', () => {
      const favoritesCount = document.getElementById('favorites-count');
      if (favoritesCount) {
        const favorites = JSON.parse(localStorage.getItem('favorites') || '[]');
        favoritesCount.textContent = favorites.length;
      }
    });

    // Update favorites count when profile card is shown
    if (profileCard) {
      const observer = new MutationObserver((mutations) => {
        mutations.forEach((mutation) => {
          if (mutation.type === 'attributes' && mutation.attributeName === 'class') {
            if (!profileCard.classList.contains('hidden')) {
              const favoritesCount = document.getElementById('favorites-count');
              if (favoritesCount) {
                const favorites = JSON.parse(localStorage.getItem('favorites') || '[]');
                favoritesCount.textContent = favorites.length;
              }
            }
          }
        });
      });

      observer.observe(profileCard, { attributes: true });
    }
    
    // Bersihkan listener saat unmount
    return () => {
      if (unsubscribe) unsubscribe();
    };
  });
</script>

<style>
  /* Anime-inspired login container */
  .anime-login-container {
    background: linear-gradient(to right, #000428, #004e92);
    position: relative;
    overflow: hidden;
  }
  
  /* Sakura petals animation */
  .anime-decoration-elements {
    position: absolute;
    width: 100%;
    height: 100%;
    top: 0;
    left: 0;
    overflow: hidden;
    pointer-events: none;
  }
  
  .sakura-petal {
    position: absolute;
    background-image: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="%23ffc0cb"><path d="M12,1C7.58,1,4,4.58,4,9c0,7,3,14,8,14c5,0,8-7,8-14C20,4.58,16.42,1,12,1z"/></svg>');
